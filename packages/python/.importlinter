# Architecture rules, checked by `lint-imports` (part of `make ci`).
#
# Imports used only for type checking are ignored: they never run, and pointing
# upward for annotations (loops -> agent) is intended.
#
# The order below is the one the code follows today (checked against the real
# import graph). A package on a lower line must not import one above it. Packages
# joined by `:` may import each other; packages joined by `|` may not.
# SQL implementations and the engine factory live in runtime.stores, below agent/store.
[importlinter]
contract_types =
    forbidden: tools.split_imports.PresentForbiddenContract
root_package = dendrux
include_external_packages = True
exclude_type_checking_imports = True

[importlinter:contract:layers]
name = Dendrux layers: imports point down, never up
type = layers
containers = dendrux
exhaustive = True
layers =
    cli | store | notifiers | testing
    agent
    runtime
    loops : skills
    mcp
    tool : tools
    llm | guardrails
    chat
    pricing | context_blocks | strategies | media | db
    types : _wire : _lifecycle
    errors | _sentinel | _redact | _meta_keys
    _codes | _warnings

[importlinter:contract:no-persistence-below-the-runtime]
name = Core layers know nothing about persistence or the runtime
type = forbidden
source_modules =
    dendrux.types
    dendrux.errors
    dendrux.tool
    dendrux.tools
    dendrux.strategies
    dendrux.guardrails
    dendrux.context_blocks
    dendrux.pricing
    dendrux.chat
    dendrux.llm
    dendrux.mcp
forbidden_modules =
    dendrux.db
    dendrux.runtime
    sqlalchemy
    alembic

[importlinter:contract:provider-sdk-in-adapters]
name = The Anthropic and OpenAI SDKs are imported only by their provider adapters
type = forbidden
source_modules = dendrux
forbidden_modules =
    anthropic
    openai
allow_indirect_imports = True
ignore_imports =
    dendrux.llm.anthropic -> anthropic
    dendrux.llm.openai -> openai
    dendrux.llm.openai_responses -> openai

[importlinter:contract:mcp-sdk-in-mcp]
name = The MCP SDK is imported only inside dendrux.mcp
type = forbidden
source_modules = dendrux
forbidden_modules =
    mcp
    httpx2
    httpcore2
allow_indirect_imports = True
ignore_imports =
    dendrux.mcp -> mcp
    dendrux.mcp.** -> mcp
    dendrux.mcp.** -> httpx2
    dendrux.mcp.** -> httpcore2

[importlinter:contract:redis-in-live-updates]
name = The Redis client is imported only by the Redis live-updates transport
type = forbidden
source_modules = dendrux
forbidden_modules =
    redis
allow_indirect_imports = True
ignore_imports =
    dendrux.db._redis_updates -> redis

[importlinter:contract:otel-in-notifiers]
name = OpenTelemetry is imported only by the OTel notifier
type = forbidden
source_modules = dendrux
forbidden_modules =
    opentelemetry
allow_indirect_imports = True
ignore_imports =
    dendrux.notifiers.otel -> opentelemetry

[importlinter:contract:split-no-facade-backedge]
name = Split operation modules cannot import compatibility facades
type = forbidden
source_modules =
    dendrux.runtime._run_errors
    dendrux.runtime._run_pending
    dendrux.runtime._run_contracts
    dendrux.runtime._run_observers
    dendrux.runtime._run_events
    dendrux.runtime._run_tools
    dendrux.runtime._run_images
    dendrux.runtime._run_entry
    dendrux.runtime._run_start
    dendrux.runtime._run_outcome
    dendrux.runtime._run_execute
    dendrux.runtime._run_retry
    dendrux.runtime._run_stream
    dendrux.runtime._run_resume_prep
    dendrux.runtime._run_resume_replay
    dendrux.runtime._run_approval
    dendrux.runtime._run_resume_loop
    dendrux.runtime._run_resume
    dendrux.runtime._run_resume_stream
    dendrux.runtime.stores.sql._sql_host
    dendrux.runtime.stores.sql._sql_sessions
    dendrux.runtime.stores.sql._sql_support
    dendrux.runtime.stores.sql._sql_sweep_scan
    dendrux.runtime.stores.sql._sql_writes
    dendrux.runtime.stores.sql._sql_runs
    dendrux.runtime.stores.sql._sql_evidence
    dendrux.runtime.stores.sql._sql_managed
    dendrux.runtime.stores.sql._sql_tree
    dendrux.runtime.stores.sql._sql_lifecycle
    dendrux.runtime.stores.sql._sql_pause
    dendrux.runtime.stores.sql._sql_reads
    dendrux.runtime.stores.sql._sql_events
    dendrux.runtime.stores.sql._sql_claims
    dendrux.runtime.stores.sql._sql_leases
    dendrux.runtime.stores.sql._sql_sweep
forbidden_modules =
    dendrux.runtime.runner
    dendrux.runtime.stores.sql.base
allow_indirect_imports = True
as_packages = False
